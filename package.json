{
  "name": "stamp-track",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run -w @stamp-track/api package",
    "lint": "npm run -w @stamp-track/api lint",
    "prisma:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "dev:db": "docker compose up -d"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "typescript": "^5.4.5"
  }
}
